{
  "name": "ciudad-2050",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ciudad solarpunk 2050 — experiencia 3D/VR generada por codigo",
  "scripts": {
    "dev": "vite",
    "dev:vr": "vite --config vite.vr.config.ts --host 0.0.0.0 --port 5181 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,tools}/**/*.{ts,mjs}\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run verify && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/materials": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
